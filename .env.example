# MongoDB Atlas Connection URI (Server-Only Secret)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/pragyan

# JWT Authentication Secret Key (Server-Only Secret)
JWT_SECRET=your-production-jwt-secret-key-here

# Express Server Port
PORT=5000

# CORS Allowed Origins (Comma Separated)
ALLOWED_ORIGINS=https://pragyan-2k26.vercel.app,http://localhost:5173

# Public Firebase Web Client Configuration (Vite Public)
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=pragyan-2k26.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=pragyan-2k26
VITE_FIREBASE_STORAGE_BUCKET=pragyan-2k26.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
